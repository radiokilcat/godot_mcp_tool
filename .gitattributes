# Normalize to LF in the repository; checkouts still get the platform's native
# endings. Without this, GDScript and TypeScript churn between CRLF and LF
# depending on who commits from where.
* text=auto eol=lf

# Godot reads these as text regardless of platform
*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.cfg   text eol=lf
*.gdshader text eol=lf

# Binary — never touch
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.exe binary
