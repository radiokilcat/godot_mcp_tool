# Godot
.godot/
*.gdscene
*.gd.bak
*.tscn.bak
export_presets.cfg
.import/

# Node.js
# package-lock.json is deliberately NOT ignored: the e2e suite runs the production
# build, so a green run has to be reproducible from a pinned dependency tree.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock

# Build output
#
# Ignored by location, not by extension. A blanket `*.js` used to sit here with a
# `!tests/**/*.js` exception, which meant any helper .js added anywhere in the repo
# was silently never committed — the e2e runner survives only because it is written
# as .mjs. The exception itself pointed at a tests/ directory 9.2 deleted. tsc emits
# solely into server/dist (outDir in tsconfig.json), so `dist/` already covers the
# build output on its own.
dist/
build/

# Local MCP client config — it holds an absolute path to this checkout.
# The committed template is .mcp.json.example
.mcp.json

# IDEs
.vscode/
.idea/
.opencode/
opencode.json
*.swp
*.swo
*~
.DS_Store

# Environment
.env
.env.local
.env.*.local

# OS
Thumbs.db
.DS_Store

# Logs
logs/
*.log

# Test coverage
coverage/
.nyc_output/

# Temporary
tmp/
temp/
*.tmp
.e2e_work

# Claude Code local settings (personal, do not commit)
.claude/settings.local.json
