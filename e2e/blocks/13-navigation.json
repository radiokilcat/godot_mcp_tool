{
  "block": 13,
  "name": "Navigation Tools",
  "setup": [
    { "tool": "create_scene", "args": { "name": "NavRoot", "root_type": "Node2D", "path": "res://test_nav.tscn" } },
    { "tool": "open_scene", "args": { "scene_path": "res://test_nav.tscn" } }
  ],
  "tests": [
    {
      "id": "NAV-01",
      "tool": "add_navigation_region",
      "args": { "parent_path": ".", "node_name": "NavRegion", "dimension": "2d" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "NAV-02",
      "tool": "add_navigation_agent",
      "args": { "parent_path": ".", "node_name": "NavAgent", "dimension": "2d" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "NAV-03",
      "tool": "set_navigation_layer",
      "args": { "node_path": "NavRegion", "navigation_layers": [1] },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "NAV-04",
      "tool": "get_navigation_info",
      "args": {},
      "asserts": [{ "field": "", "op": "notEmpty" }]
    },
    {
      "id": "NAV-04b",
      "tool": "execute_script",
      "comment": "add_navigation_region leaves an empty NavigationPolygon with no outline — bake_navigation would have nothing to build, and get_navigation_path nothing to route across. A real square outline is what makes both of the next two tests observable rather than vacuous.",
      "args": { "code": "var r := EditorInterface.get_edited_scene_root().get_node(\"NavRegion\")\nvar poly: NavigationPolygon = r.navigation_polygon\npoly.clear_outlines()\npoly.add_outline(PackedVector2Array([Vector2(0, 0), Vector2(200, 0), Vector2(200, 200), Vector2(0, 200)]))\nreturn {\"outline_count\": poly.get_outline_count()}" },
      "asserts": [{ "field": "result.outline_count", "op": "eq", "value": 1 }]
    },
    {
      "id": "NAV-06",
      "tool": "bake_navigation",
      "args": { "node_path": "NavRegion" },
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "type", "op": "eq", "value": "NavigationRegion2D" }
      ],
      "verify": {
        "tool": "execute_script",
        "args": { "code": "var r := EditorInterface.get_edited_scene_root().get_node(\"NavRegion\")\nreturn {\"polygon_count\": r.navigation_polygon.get_polygon_count()}" },
        "asserts": [{ "field": "result.polygon_count", "op": "gte", "value": 1 }]
      }
    },
    {
      "id": "NAV-05",
      "tool": "get_navigation_path",
      "comment": "Runs after the bake (NAV-06) so the region actually has navigable area to route across — otherwise the server has nothing to build a path from and this passes for the wrong reason.",
      "args": { "from": "Vector2(10, 10)", "to": "Vector2(150, 150)", "dimension": "2d" },
      "delayMs": 300,
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "point_count", "op": "gte", "value": 2 }
      ]
    }
  ],
  "cleanup": [
    { "tool": "delete_scene", "args": { "scene_path": "res://test_nav.tscn" } }
  ]
}
