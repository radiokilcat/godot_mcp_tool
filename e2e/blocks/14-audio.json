{
  "block": 14,
  "name": "Audio Tools",
  "setup": [
    { "tool": "create_scene", "args": { "name": "AudioRoot", "root_type": "Node", "path": "res://test_audio.tscn" } },
    { "tool": "open_scene", "args": { "scene_path": "res://test_audio.tscn" } }
  ],
  "tests": [
    {
      "id": "AU-01",
      "tool": "add_audio_player",
      "args": { "parent_path": ".", "node_name": "Player", "type": "2d" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "AU-02",
      "tool": "configure_bus",
      "args": { "bus_name": "Master", "volume_db": -6.0 },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "AU-03",
      "tool": "add_audio_effect",
      "args": { "bus_name": "Master", "effect_type": "reverb", "effect_name": "TestReverb" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "AU-04",
      "tool": "configure_bus",
      "args": { "bus_name": "Master", "volume_db": 0.0 },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "AU-05",
      "tool": "load_audio_file",
      "args": { "node_path": "Player", "file_path": "res://nonexistent.ogg" },
      "expectError": true
    },
    {
      "id": "AU-05b",
      "tool": "execute_script",
      "comment": "AU-05 is a negative test (nonexistent.ogg), so Player still has no stream — play_audio would have nothing to actually play. A short real AudioStreamWAV is assigned directly so AU-06/AU-07 exercise real playback state, not just the tools' own (unverified) claims.",
      "args": { "code": "var stream := AudioStreamWAV.new()\nstream.format = AudioStreamWAV.FORMAT_16_BITS\nstream.mix_rate = 44100\nstream.stereo = false\nvar data := PackedByteArray()\ndata.resize(44100)\nstream.data = data\nvar p := EditorInterface.get_edited_scene_root().get_node(\"Player\")\np.stream = stream\nreturn {\"assigned\": p.stream != null}" },
      "asserts": [{ "field": "result.assigned", "op": "eq", "value": true }]
    },
    {
      "id": "AU-06",
      "tool": "play_audio",
      "comment": "play_audio's 'playing: true' in its own response is hardcoded, not read back from the node — the verify step is what actually proves playback started.",
      "args": { "node_path": "Player" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }],
      "verify": {
        "tool": "get_variable_value",
        "args": { "node_path": "Player", "variable": "playing" },
        "asserts": [{ "field": "value", "op": "eq", "value": true }]
      }
    },
    {
      "id": "AU-07",
      "tool": "stop_audio",
      "args": { "node_path": "Player" },
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "was_playing", "op": "eq", "value": true }
      ],
      "verify": {
        "tool": "get_variable_value",
        "args": { "node_path": "Player", "variable": "playing" },
        "asserts": [{ "field": "value", "op": "eq", "value": false }]
      }
    }
  ],
  "cleanup": [
    { "tool": "delete_scene", "args": { "scene_path": "res://test_audio.tscn" } }
  ]
}
