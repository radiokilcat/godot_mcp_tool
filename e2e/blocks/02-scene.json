{
  "block": 2,
  "name": "Scene Tools",
  "setup": [],
  "tests": [
    {
      "id": "S-01",
      "tool": "get_scene_tree",
      "args": {},
      "expectError": true,
      "errorContains": "cene"
    },
    {
      "id": "S-02",
      "tool": "create_scene",
      "args": { "name": "TestRoot", "root_type": "Node2D", "path": "res://test_scene.tscn" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }],
      "comment": "Node-header assertions stop after the type and never include the closing bracket: Godot 4.7 writes [node name=\"X\" type=\"Y\" unique_id=982333479] where 4.4 writes [node name=\"X\" type=\"Y\"]. Matching the bracket passes on 4.4 and fails on 4.7 for no real reason.",
      "expectFiles": [
        { "path": "res://test_scene.tscn", "op": "contains", "value": "[node name=\"TestRoot\" type=\"Node2D\"" }
      ]
    },
    {
      "id": "S-03",
      "tool": "list_project_files",
      "args": { "path": "res://", "filter": ".tscn" },
      "asserts": [{ "field": "files", "op": "contains", "value": "res://test_scene.tscn" }]
    },
    {
      "id": "S-04",
      "tool": "open_scene",
      "args": { "scene_path": "res://test_scene.tscn" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "S-05",
      "tool": "get_scene_tree",
      "args": {},
      "asserts": [
        { "field": "", "op": "jsonContains", "value": "TestRoot" },
        { "field": "", "op": "jsonContains", "value": "Node2D" }
      ]
    },
    {
      "id": "S-06",
      "tool": "get_scene_info",
      "args": { "scene_path": "res://test_scene.tscn" },
      "asserts": [
        { "field": "", "op": "jsonContains", "value": "test_scene.tscn" },
        { "field": "", "op": "jsonContains", "value": "Node2D" }
      ]
    },
    {
      "id": "S-07",
      "tool": "list_open_scenes",
      "args": {},
      "asserts": [{ "field": "", "op": "jsonContains", "value": "test_scene.tscn" }]
    },
    {
      "id": "S-08a",
      "tool": "create_scene",
      "args": { "name": "Prefab", "root_type": "Sprite2D", "path": "res://test_prefab.tscn" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "S-08b",
      "tool": "open_scene",
      "args": { "scene_path": "res://test_scene.tscn" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "S-08c",
      "tool": "instantiate_scene",
      "args": { "scene_path": "res://test_prefab.tscn", "parent_path": ".", "node_name": "PrefabInstance" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }],
      "verify": {
        "tool": "get_scene_tree",
        "args": {},
        "asserts": [{ "field": "", "op": "jsonContains", "value": "PrefabInstance" }]
      }
    },
    {
      "id": "S-09a",
      "tool": "play_scene",
      "args": { "scene_path": "res://test_scene.tscn" },
      "requires": { "rendering": true },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "S-09b",
      "tool": "stop_scene",
      "args": {},
      "requires": { "rendering": true },
      "delayMs": 2000,
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "S-09c",
      "tool": "delete_node",
      "args": { "node_path": "PrefabInstance" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "S-09d",
      "tool": "save_scene",
      "args": {},
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "scene_path", "op": "eq", "value": "res://test_scene.tscn" }
      ],
      "comment": "The point of 6.6.9: S-09c deleted PrefabInstance from the open scene, and only this save commits it. A save that silently did nothing still reports success — the on-disk file is what tells them apart.",
      "expectFiles": [
        { "path": "res://test_scene.tscn", "op": "notContains", "value": "PrefabInstance" },
        { "path": "res://test_scene.tscn", "op": "contains", "value": "[node name=\"TestRoot\" type=\"Node2D\"" }
      ]
    },
    {
      "id": "S-10",
      "tool": "delete_scene",
      "args": { "scene_path": "res://test_prefab.tscn" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }],
      "verify": {
        "tool": "list_project_files",
        "args": { "path": "res://", "filter": ".tscn" },
        "asserts": [{ "field": "files", "op": "notContains", "value": "res://test_prefab.tscn" }]
      },
      "expectFiles": [{ "path": "res://test_prefab.tscn", "op": "absent" }]
    },
    {
      "id": "S-11",
      "tool": "create_scene",
      "args": {
        "name": "Nested",
        "root_type": "Node2D",
        "path": "res://e2e_nested/deep/Nested.tscn",
        "open_after_create": false
      },
      "asserts": [{ "field": "success", "op": "eq", "value": true }],
      "verify": {
        "tool": "list_project_files",
        "args": { "path": "res://e2e_nested/deep", "filter": ".tscn" },
        "asserts": [
          { "field": "files", "op": "contains", "value": "res://e2e_nested/deep/Nested.tscn" }
        ]
      },
      "comment": "6.6.6 — create_scene did not create the parent directories, so a nested path failed with \"Can't open\".",
      "expectFiles": [
        { "path": "res://e2e_nested/deep/Nested.tscn", "op": "contains", "value": "[node name=\"Nested\" type=\"Node2D\"" }
      ]
    },
    {
      "id": "S-12",
      "tool": "save_scene",
      "args": { "scene_path": "res://e2e_saveas/Copy.tscn" },
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "scene_path", "op": "eq", "value": "res://e2e_saveas/Copy.tscn" }
      ],
      "verify": {
        "tool": "list_project_files",
        "args": { "path": "res://e2e_saveas", "filter": ".tscn" },
        "asserts": [{ "field": "files", "op": "contains", "value": "res://e2e_saveas/Copy.tscn" }]
      },
      "comment": "save_scene_as returns void, so the plugin can only confirm the write by checking the file landed — assert the same thing here, independently.",
      "expectFiles": [
        { "path": "res://e2e_saveas/Copy.tscn", "op": "contains", "value": "[node name=\"TestRoot\" type=\"Node2D\"" }
      ]
    }
  ],
  "cleanup": [
    { "tool": "delete_scene", "args": { "scene_path": "res://test_scene.tscn" } },
    { "tool": "delete_scene", "args": { "scene_path": "res://e2e_nested/deep/Nested.tscn" } },
    { "tool": "delete_scene", "args": { "scene_path": "res://e2e_saveas/Copy.tscn" } }
  ]
}
