{
  "block": 5,
  "name": "Editor Tools",
  "setup": [
    { "tool": "create_scene", "args": { "name": "EditorRoot", "root_type": "Node2D", "path": "res://test_editor.tscn" } },
    { "tool": "open_scene", "args": { "scene_path": "res://test_editor.tscn" } }
  ],
  "tests": [
    {
      "id": "E-01",
      "tool": "get_editor_state",
      "args": {},
      "asserts": [{ "field": "has_open_scene", "op": "notNull" }]
    },
    {
      "id": "E-02",
      "tool": "get_editor_state",
      "args": {},
      "asserts": [
        { "field": "has_open_scene", "op": "eq", "value": true },
        { "field": "active_scene", "op": "contains", "value": "test_editor" }
      ]
    },
    {
      "id": "E-03",
      "tool": "get_error_log",
      "args": {},
      "asserts": [
        { "field": "", "op": "notEmpty" },
        { "field": "file_logging_enabled", "op": "notNull" }
      ]
    },
    {
      "id": "E-03b",
      "tool": "play_scene",
      "args": { "scene_path": "res://test_editor.tscn" },
      "requires": { "rendering": true },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "E-03c",
      "tool": "stop_scene",
      "args": {},
      "requires": { "rendering": true },
      "delayMs": 2000,
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "E-03d",
      "tool": "get_error_log",
      "args": { "last_n_lines": 20 },
      "requires": { "rendering": true },
      "asserts": [
        { "field": "log_path", "op": "contains", "value": ".log" },
        { "field": "lines", "op": "notEmpty" },
        { "field": "lines", "op": "contains", "value": "Godot Engine v" },
        { "field": "modified_time", "op": "gte", "value": 1 }
      ]
    },
    {
      "id": "E-04",
      "tool": "take_screenshot",
      "args": { "save_path": "res://screenshot_a.png" },
      "requires": { "rendering": true },
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "width", "op": "gte", "value": 100 },
        { "field": "height", "op": "gte", "value": 100 }
      ]
    },
    {
      "id": "E-04b",
      "tool": "take_screenshot",
      "args": { "viewport": "camera", "save_path": "res://screenshot_nocam.png" },
      "expectError": true,
      "errorContains": "No Camera3D or Camera2D"
    },
    {
      "id": "E-04c",
      "tool": "add_node",
      "args": { "parent_path": ".", "node_type": "Camera2D", "node_name": "ViewCam" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "E-04d",
      "tool": "take_screenshot",
      "args": { "viewport": "camera", "save_path": "res://screenshot_cam2d.png", "width": 240, "height": 160 },
      "requires": { "rendering": true },
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "width", "op": "eq", "value": 240 },
        { "field": "height", "op": "eq", "value": 160 },
        { "field": "camera", "op": "eq", "value": "ViewCam" },
        { "field": "zoom.x", "op": "gte", "value": 0.001 }
      ]
    },
    {
      "id": "E-05",
      "tool": "select_node_in_editor",
      "args": { "node_path": "." },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "E-06",
      "tool": "get_editor_state",
      "args": {},
      "asserts": [{ "field": "", "op": "notEmpty" }]
    },
    {
      "id": "E-07",
      "tool": "focus_editor",
      "args": {},
      "requires": { "rendering": true },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "E-08",
      "tool": "execute_script",
      "args": { "code": "print(2 + 2)" },
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "note", "op": "contains", "value": "mcp_print" }
      ]
    },
    {
      "id": "E-08b",
      "tool": "execute_script",
      "args": { "code": "mcp_print(\"sum=\", 2 + 2)" },
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "output", "op": "contains", "value": "sum=4" }
      ]
    },
    {
      "id": "E-08c",
      "tool": "execute_script",
      "args": { "code": "return {\"n\": 7, \"v\": Vector2(1, 2)}" },
      "asserts": [
        { "field": "result.n", "op": "eq", "value": 7 },
        { "field": "result.v.x", "op": "eq", "value": 1 }
      ]
    },
    {
      "id": "E-08d",
      "tool": "execute_script",
      "args": {
        "code": "func _run():\n\tmcp_print(\"before\")\n\tawait Engine.get_main_loop().process_frame\n\tmcp_print(\"after\")\n\treturn 42\n"
      },
      "asserts": [
        { "field": "output", "op": "contains", "value": "before" },
        { "field": "output", "op": "contains", "value": "after" },
        { "field": "result", "op": "eq", "value": 42 }
      ]
    },
    {
      "id": "E-08e",
      "tool": "execute_script",
      "args": {
        "code": "signal never_fires\nfunc _run():\n\tmcp_print(\"waiting\")\n\tawait never_fires\n",
        "timeout": 0.5
      },
      "expectError": true,
      "errorContains": "did not finish"
    },
    {
      "id": "E-08f",
      "tool": "execute_script",
      "args": { "code": "return 1" },
      "asserts": [{ "field": "result", "op": "eq", "value": 1 }]
    },
    {
      "id": "E-08g",
      "tool": "execute_script",
      "args": { "code": "var x = 1\nthis is not gdscript\n" },
      "expectError": true,
      "errorContains": "line 2:"
    },
    {
      "id": "E-08h",
      "tool": "execute_script",
      "args": { "code": "func _run():\n\tvar y = 2\n\treturn y +\n" },
      "expectError": true,
      "errorContains": "line 3:"
    },
    {
      "id": "E-09",
      "tool": "execute_script",
      "args": { "code": "EditorInterface.get_editor_main_screen().show()" },
      "requires": { "rendering": true }
    },
    {
      "id": "E-10",
      "tool": "open_editor_settings",
      "args": {},
      "asserts": [{ "field": "count", "op": "gte", "value": 1 }]
    }
  ],
  "cleanup": [
    { "tool": "execute_script", "args": { "code": "DirAccess.remove_absolute(ProjectSettings.globalize_path(\"res://screenshot_cam2d.png\"))\nEditorInterface.get_resource_filesystem().scan()" } },
    { "tool": "delete_scene", "args": { "scene_path": "res://test_editor.tscn" } }
  ]
}
