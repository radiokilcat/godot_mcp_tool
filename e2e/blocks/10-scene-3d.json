{
  "block": 10,
  "name": "3D Scene Tools",
  "setup": [
    { "tool": "create_scene", "args": { "name": "Root3D", "root_type": "Node3D", "path": "res://test_3d.tscn" } },
    { "tool": "open_scene", "args": { "scene_path": "res://test_3d.tscn" } }
  ],
  "tests": [
    {
      "id": "3D-01",
      "tool": "add_mesh",
      "args": { "parent_path": ".", "node_name": "TestBox", "mesh_type": "BoxMesh" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }],
      "verify": {
        "tool": "get_scene_tree",
        "args": {},
        "asserts": [{ "field": "", "op": "jsonContains", "value": "TestBox" }]
      }
    },
    {
      "id": "3D-02",
      "tool": "add_camera",
      "args": { "parent_path": ".", "node_name": "TestCam", "position": "Vector3(0, 2, 5)" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }],
      "verify": {
        "tool": "execute_script",
        "args": {
          "code": "var cam = EditorInterface.get_edited_scene_root().get_node(\"TestCam\")\nreturn {\"x\": cam.position.x, \"y\": cam.position.y, \"z\": cam.position.z}"
        },
        "asserts": [
          { "field": "result.y", "op": "eq", "value": 2 },
          { "field": "result.z", "op": "eq", "value": 5 }
        ]
      }
    },
    {
      "id": "3D-02b",
      "tool": "add_camera",
      "args": {
        "parent_path": ".",
        "node_name": "OrthoCam",
        "projection": "orthogonal",
        "size": 12.5,
        "position": { "x": 0, "y": 8, "z": 0 }
      },
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "projection", "op": "eq", "value": "orthogonal" },
        { "field": "size", "op": "eq", "value": 12.5 },
        { "field": "fov", "op": "isNull" }
      ],
      "verify": {
        "tool": "execute_script",
        "args": {
          "code": "var cam = EditorInterface.get_edited_scene_root().get_node(\"OrthoCam\")\nreturn {\"size\": cam.size, \"proj\": cam.projection, \"y\": cam.position.y}"
        },
        "asserts": [
          { "field": "result.size", "op": "eq", "value": 12.5 },
          { "field": "result.proj", "op": "eq", "value": 1 },
          { "field": "result.y", "op": "eq", "value": 8 }
        ]
      }
    },
    {
      "id": "3D-02c",
      "tool": "add_mesh",
      "args": {
        "parent_path": ".",
        "node_name": "Worker",
        "mesh_type": "capsule",
        "mesh_properties": { "radius": 0.35, "height": 1.8 },
        "material_color": "#c0392b"
      },
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "mesh_type", "op": "eq", "value": "capsule" },
        { "field": "mesh_properties.height", "op": "eq", "value": 1.8 },
        { "field": "unknown_properties", "op": "isNull" }
      ],
      "verify": {
        "tool": "execute_script",
        "args": {
          "code": "var m = EditorInterface.get_edited_scene_root().get_node(\"Worker\").mesh\nreturn {\"cls\": m.get_class(), \"height\": m.height, \"radius\": m.radius, \"albedo\": m.material.albedo_color.to_html(false)}"
        },
        "asserts": [
          { "field": "result.cls", "op": "eq", "value": "CapsuleMesh" },
          { "field": "result.height", "op": "eq", "value": 1.8 },
          { "field": "result.radius", "op": "eq", "value": 0.35 },
          { "field": "result.albedo", "op": "eq", "value": "c0392b" }
        ]
      }
    },
    {
      "id": "3D-02d",
      "tool": "add_mesh",
      "args": { "parent_path": ".", "node_name": "Typo", "mesh_type": "sphere", "mesh_properties": { "radius": 2, "raduis": 9 } },
      "asserts": [
        { "field": "mesh_properties.radius", "op": "eq", "value": 2 },
        { "field": "unknown_properties", "op": "contains", "value": "raduis" }
      ]
    },
    {
      "id": "3D-02e",
      "tool": "add_mesh",
      "args": { "parent_path": ".", "node_name": "Bad", "mesh_type": "dodecahedron" },
      "expectError": true,
      "errorContains": "Unknown mesh_type"
    },
    {
      "id": "3D-03",
      "tool": "add_light",
      "args": { "parent_path": ".", "node_name": "TestLight", "light_type": "DirectionalLight3D" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "3D-04",
      "tool": "set_environment",
      "args": { "ambient_light_color": "#333333", "ambient_light_energy": 1.0 },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "3D-05",
      "tool": "get_3d_scene_info",
      "args": {},
      "asserts": [
        { "field": "", "op": "jsonContains", "value": "TestBox" },
        { "field": "", "op": "jsonContains", "value": "TestCam" },
        { "field": "", "op": "jsonContains", "value": "TestLight" }
      ]
    },
    {
      "id": "3D-06",
      "tool": "add_gridmap",
      "args": { "parent_path": ".", "node_name": "TestGrid", "cell_size": "Vector3(1, 1, 1)" },
      "asserts": [{ "field": "success", "op": "eq", "value": true }]
    },
    {
      "id": "3D-06b",
      "tool": "save_scene",
      "comment": "The add_* family, checked below the response. 6.6.14 is the reason the transform matters: the string form \"Vector3(0, 2, 5)\" was silently dropped outside node_tools, so add_camera put the camera at the origin and still answered success — a response-level assertion on the same call could not see it. 3D-02e's rejected mesh_type must likewise have left no node behind (6.6.12).",
      "args": {},
      "asserts": [{ "field": "success", "op": "eq", "value": true }],
      "expectFiles": [
        { "path": "res://test_3d.tscn", "op": "contains", "value": "[node name=\"TestBox\" type=\"MeshInstance3D\"" },
        { "path": "res://test_3d.tscn", "op": "contains", "value": "[node name=\"TestLight\" type=\"DirectionalLight3D\"" },
        { "path": "res://test_3d.tscn", "op": "contains", "value": "[node name=\"TestGrid\" type=\"GridMap\"" },
        { "path": "res://test_3d.tscn", "op": "matches", "value": "\\[node name=\"TestCam\"[\\s\\S]*?transform = Transform3D\\([^)]*, 0, 2, 5\\)" },
        { "path": "res://test_3d.tscn", "op": "matches", "value": "\\[node name=\"OrthoCam\"[\\s\\S]*?size = 12\\.5" },
        { "path": "res://test_3d.tscn", "op": "notContains", "value": "name=\"Bad\"" }
      ]
    },
    {
      "id": "3D-07",
      "tool": "take_screenshot",
      "args": {
        "viewport": "camera",
        "camera_path": "TestCam",
        "save_path": "res://screenshot_cam3d.png",
        "width": 320,
        "height": 200
      },
      "requires": { "rendering": true },
      "asserts": [
        { "field": "success", "op": "eq", "value": true },
        { "field": "width", "op": "eq", "value": 320 },
        { "field": "height", "op": "eq", "value": 200 },
        { "field": "camera", "op": "eq", "value": "TestCam" },
        { "field": "projection", "op": "eq", "value": "perspective" },
        { "field": "fov", "op": "gte", "value": 1 }
      ],
      "verify": {
        "tool": "list_project_files",
        "args": { "path": "res://", "filter": ".png" },
        "asserts": [{ "field": "files", "op": "contains", "value": "screenshot_cam3d.png" }]
      }
    },
    {
      "id": "3D-07b",
      "tool": "execute_script",
      "args": {
        "code": "var img = Image.load_from_file(ProjectSettings.globalize_path(\"res://screenshot_cam3d.png\"))\nif img == null:\n\treturn {\"loaded\": false}\nvar first = img.get_pixel(0, 0)\nvar distinct = 0\nfor x in range(0, img.get_width(), 4):\n\tfor y in range(0, img.get_height(), 4):\n\t\tif img.get_pixel(x, y) != first:\n\t\t\tdistinct += 1\nreturn {\"loaded\": true, \"w\": img.get_width(), \"h\": img.get_height(), \"distinct\": distinct}"
      },
      "requires": { "rendering": true },
      "asserts": [
        { "field": "result.loaded", "op": "eq", "value": true },
        { "field": "result.w", "op": "eq", "value": 320 },
        { "field": "result.h", "op": "eq", "value": 200 },
        { "field": "result.distinct", "op": "gte", "value": 50 }
      ]
    },
    {
      "id": "3D-08",
      "tool": "take_screenshot",
      "args": { "viewport": "camera", "camera_path": "TestBox", "save_path": "res://screenshot_bad.png" },
      "expectError": true,
      "errorContains": "not a Camera3D"
    }
  ],
  "cleanup": [
    { "tool": "execute_script", "args": { "code": "for p in [\"res://screenshot_cam3d.png\"]:\n\tDirAccess.remove_absolute(ProjectSettings.globalize_path(p))\n\tDirAccess.remove_absolute(ProjectSettings.globalize_path(p + \".import\"))\n\tEditorInterface.get_resource_filesystem().update_file(p)\nEditorInterface.get_resource_filesystem().scan()" } },
    { "tool": "delete_scene", "args": { "scene_path": "res://test_3d.tscn" } }
  ]
}
